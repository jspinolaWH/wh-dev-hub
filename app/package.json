{
  "name": "@wh/app",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5199 --strictPort\" \"wait-on tcp:127.0.0.1:5199 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5199 electron .\"",
    "build": "vite build",
    "icons": "node scripts/make-icons.cjs",
    "pack": "npm run icons && vite build && electron-builder --win --dir --config.directories.output=%LOCALAPPDATA%\\wh-hub-release",
    "dist": "npm run icons && vite build && electron-builder --win nsis --config.directories.output=%LOCALAPPDATA%\\wh-hub-release"
  },
  "description": "WasteHero Dev Hub — persistent Claude Code sessions on the office host",
  "author": "WasteHero",
  "build": {
    "appId": "io.wastehero.devhub",
    "productName": "WasteHero Dev Hub",
    "electronVersion": "33.4.11",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "dist/**",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@wh/shared": "*",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.1"
  }
}
